# Copy to .env and replace every value. Never commit .env.
NODE_ENV=production
POSTGRES_PASSWORD=change-me-long-random
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Generate: openssl rand -hex 32   (encrypts device secrets at rest; back it up separately)
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=https://adms.example.ph
TRUST_PROXY_HOPS=1
DEFAULT_TIMEZONE=Asia/Manila
DEVICE_ONLINE_THRESHOLD_SEC=180
DEVICE_MONITOR_INTERVAL_SEC=60
ALLOW_MOCK_DEVICES=false
LOG_LEVEL=info
# Development seed only
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=
